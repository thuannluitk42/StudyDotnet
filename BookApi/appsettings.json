{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "AspNetCoreRateLimit": "Information"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=bookapi.db"
    },
    "Jwt": {
        "Key": "yH5tX1w1pCwF3o92mVbq7Jx4Tn8gZs0LkA9rT2vE5uB6nQ8sY7xD0cF3gH6jK9mN2pR5tV8wZ1",
        "Issuer": "BookApi",
        "Audience": "BookApiClient",
        "AccessTokenLifetimeMinutes": 60,
        "RefreshTokenLifetimeDays": 7
    },
    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
        "RealIpHeader": "X-Real-IP",
        "ClientIdHeader": "X-ClientId",
        "HttpStatusCode": 429,
        "QuotaExceededResponse": {
            "Content": "{\"error\": \"Too Many Requests\", \"detail\": \"Rate limit exceeded. Please try again later.\"}",
            "ContentType": "application/json",
            "StatusCode": 429
        },
        "GeneralRules": [
            {
                "Endpoint": "*",
                "Period": "1m",
                "Limit": 120
            },
            {
                "Endpoint": "*",
                "Period": "1h",
                "Limit": 10000
            },
            {
                "Endpoint": "POST:/api/auth/login",
                "Period": "15m",
                "Limit": 5
            },
            {
                "Endpoint": "POST:/api/auth/register",
                "Period": "1h",
                "Limit": 10
            },
            {
                "Endpoint": "GET:/health*",
                "Period": "1m",
                "Limit": 300
            }
        ],
        "IpWhitelist": [ "127.0.0.1", "::1" ],
        "EndpointWhitelist": [ "GET:/health", "GET:/health-ui*" ]
    }
}