# ========================================
# BookApi.http — Fast API Testing
# ========================================

@BookApi_HostAddress = https://localhost:7001
@BookApi_AdminEmail = studydotnet@yopmail.com
@BookApi_AdminPassword = Abc12345@
@host = http://localhost:5238

# ========================================
# 1. LOGIN → LẤY JWT TOKEN
# ========================================
POST {{BookApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{BookApi_AdminEmail}}",
  "password": "{{BookApi_AdminPassword}}"
}

> {%
    client.global.set("jwt_token", response.body.token);
    client.global.set("token_expires", response.body.expires);
%}

###

# ========================================
# 2. GET ALL BOOKS
# ========================================
GET {{BookApi_HostAddress}}/api/books
Accept: application/json

###

# ========================================
# 3. CREATE NEW BOOK
# ========================================
POST {{BookApi_HostAddress}}/api/books
Content-Type: application/json

{
  "title": "Refactoring",
  "author": "Martin Fowler",
  "publishedYear": 1999
}

###

# ========================================
# 4. GET BOOK BY ID
# ========================================
GET {{BookApi_HostAddress}}/api/books/1
Accept: application/json

###

# ========================================
# 5. ADMIN ENDPOINT — PROTECTED
# ========================================
GET {{BookApi_HostAddress}}/api/books/admin
Authorization: Bearer {{jwt_token}}
Accept: application/json

###

# ========================================
# 6. CUSTOM MODEL BINDER — dd-MM-yyyy
# ========================================
GET {{BookApi_HostAddress}}/api/books/by-date?date=25-12-2025
Accept: application/json

###

# ========================================
# 7. MINIMAL API — ECHO
# ========================================
POST {{BookApi_HostAddress}}/echo
Content-Type: application/json

{
  "title": "Echo Test",
  "author": "You"
}

###

# ========================================
# 8. HEALTH CHECK
# ========================================
GET {{BookApi_HostAddress}}/hello
Accept: text/plain

###

### 1. LOGIN
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "studydotnet@yopmail.com",
  "password": "Abc12345@"
}

> {%
    client.global.set("access_token", response.body.accessToken);
    client.global.set("refresh_token", response.body.refreshToken);
%}

### 2. REFRESH
POST {{host}}/api/auth/refresh
Content-Type: application/json
Cookie: refreshToken={{refresh_token}}

{
  "refreshToken": "{{refresh_token}}"
}

> {%
    client.global.set("access_token", response.body.accessToken);
    client.global.set("refresh_token", response.body.refreshToken);
%}

### 3. CALL PROTECTED API
GET {{host}}/api/books/admin
Authorization: Bearer {{access_token}}

### 1. LOGIN → CÓ CLAIMS: age=25, department=IT
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "studydotnet@yopmail.com",
  "password": "Abc12345@"
}

> {%
    client.global.set("access_token", response.body.accessToken);
%}

### 2. POLICY: ADMIN → 200
GET {{host}}/api/books/admin
Authorization: Bearer {{access_token}}

### 3. POLICY: AGE ≥ 18 → 200
GET {{host}}/api/books/adult
Authorization: Bearer {{access_token}}

### 4. POLICY: IT DEPARTMENT → 200
GET {{host}}/api/books/it
Authorization: Bearer {{access_token}}

### 1. GỌI API NHIỀU LẦN → LẦN 2 SIÊU NHANH (CACHE HIT)
GET {{host}}/api/books

### 2. TẠO SÁCH MỚI → CACHE BỊ XÓA
POST {{host}}/api/books